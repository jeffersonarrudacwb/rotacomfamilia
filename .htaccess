# =============================================================================
# Rota com Família — configuração do Apache (HostGator / cPanel)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Tipos MIME
# Sem isto, servidores mais antigos entregam .webp como application/octet-stream
# e o navegador se recusa a exibir a imagem. Foi exatamente o que aconteceu no
# servidor de teste local.
# -----------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp                   .webp
  AddType image/avif                   .avif
  AddType image/svg+xml                .svg
  AddType application/pdf              .pdf
  AddType text/css                     .css
  AddType application/javascript       .js
  AddType application/font-woff2       .woff2
  AddType application/manifest+json    .webmanifest
</IfModule>

# -----------------------------------------------------------------------------
# 2. Compressão
# HTML, CSS, JS e SVG comprimem muito bem. Imagens e PDFs já vêm comprimidos:
# passar gzip neles só gasta CPU sem ganho.
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# -----------------------------------------------------------------------------
# 3. Cache
# Imagens e fontes têm nome versionado pela largura, então podem durar um ano.
# HTML fica com prazo curto para que uma correção de texto apareça rápido.
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType text/css               "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/pdf        "access plus 1 week"
  ExpiresByType text/html              "access plus 1 hour"
</IfModule>

# -----------------------------------------------------------------------------
# 4. Segurança
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # HSTS só entra depois que o HTTPS estiver funcionando em todo o domínio.
  # Descomente quando o certificado estiver ativo e testado:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Esconde arquivos de configuração e de build
<FilesMatch "^(\.htaccess|\.gitignore|package\.json|package-lock\.json|tailwind\.config\.js)$">
  Require all denied
</FilesMatch>

# -----------------------------------------------------------------------------
# 5. URLs
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Força HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Domínio único: sempre sem www (o canonical das páginas aponta para essa forma)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # -------------------------------------------------------------------------
  # O blog é um WordPress em /blog/, com .htaccess próprio. Daqui para baixo,
  # nada deve tocar nas URLs dele. Esta linha para o processamento das regras
  # deste arquivo para qualquer caminho que comece com /blog.
  #
  # Fica DEPOIS das duas regras acima de propósito: HTTPS e remoção de www
  # devem valer para o blog também.
  # -------------------------------------------------------------------------
  RewriteRule ^blog(/|$) - [L]

  # URL sem .html: /ebooks serve ebooks.html
  #
  # Duas mudancas em relacao a versao anterior, ambas por causa de um 403 real
  # em /ebooks e /mediakit:
  #
  # 1. Saiu a condicao !-d. Existiam as pastas ebooks/ e mediakit/ (com os PDFs)
  #    ao lado de ebooks.html e mediakit.html. Com !-d, a regra se recusava a
  #    agir sempre que houvesse pasta de mesmo nome, o Apache tentava listar o
  #    diretorio e o Options -Indexes devolvia 403. Os PDFs agora moram em
  #    downloads/, mas a regra fica robusta de qualquer forma.
  # 2. O padrao virou ^([^./]+)/?$ — um unico segmento, sem ponto nem barra.
  #    Assim /downloads/arquivo.pdf e /assets/img/foto.webp nunca entram aqui.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^./]+)/?$ $1.html [L]
</IfModule>

ErrorDocument 404 /index.html

# Sem listagem de diretório
Options -Indexes

# -----------------------------------------------------------------------------
# Nota sobre DirectorySlash
#
# Aqui existia um "DirectorySlash Off". Ele entrou para resolver um 403 real em
# /ebooks e /mediakit, quando havia as pastas ebooks/ e mediakit/ ao lado das
# páginas ebooks.html e mediakit.html: o Apache redirecionava /ebooks para
# /ebooks/, tentava listar a pasta e o Options -Indexes devolvia 403.
#
# Foi removido por dois motivos:
#
# 1. A causa não existe mais. Os PDFs foram para downloads/, e hoje nenhuma
#    pasta publicada (api, assets, downloads) tem o nome de uma página.
# 2. Ele quebraria o blog. As URLs do WordPress são todas em forma de
#    diretório (/blog/, /blog/categoria/brasil/). Sem o redirecionamento de
#    barra final, o caminho base fica errado e os links relativos quebram.
#
# Se algum dia voltar a existir uma pasta com o mesmo nome de uma página, a
# correção certa é renomear a pasta — não desligar o DirectorySlash.
# -----------------------------------------------------------------------------
