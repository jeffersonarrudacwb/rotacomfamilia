{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,

    "layout": {
      "contentSize": "42rem",
      "wideSize": "62rem"
    },

    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": false,
      "palette": [
        {
          "slug": "base",
          "color": "#F6F3E9",
          "name": "Papel"
        },
        {
          "slug": "base-2",
          "color": "#EFEBDC",
          "name": "Papel sombreado"
        },
        {
          "slug": "contrast",
          "color": "#22231A",
          "name": "Tinta"
        },
        {
          "slug": "contrast-2",
          "color": "#4A4B3C",
          "name": "Tinta suave"
        },
        {
          "slug": "deep",
          "color": "#14150D",
          "name": "Oliva profundo"
        },
        {
          "slug": "gold",
          "color": "#D4A437",
          "name": "Dourado"
        },
        {
          "slug": "gold-ink",
          "color": "#A5811F",
          "name": "Dourado escuro"
        },
        {
          "slug": "sunset",
          "color": "#C8732E",
          "name": "Pôr do sol"
        },
        {
          "slug": "fern",
          "color": "#A9B47E",
          "name": "Samambaia"
        },
        {
          "slug": "cream",
          "color": "#FAF1DA",
          "name": "Creme"
        },
        {
          "slug": "rule",
          "color": "#D8D2BC",
          "name": "Linha"
        }
      ]
    },

    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "writingMode": true,
      "fontFamilies": [
        {
          "slug": "serif",
          "name": "Playfair Display",
          "fontFamily": "\"Playfair Display\", Georgia, \"Iowan Old Style\", serif",
          "fontFace": [
            {
              "fontFamily": "Playfair Display",
              "fontWeight": "700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/playfair-display-700.woff2"]
            },
            {
              "fontFamily": "Playfair Display",
              "fontWeight": "800",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/playfair-display-800.woff2"]
            }
          ]
        },
        {
          "slug": "sans",
          "name": "Inter",
          "fontFamily": "Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/inter-400.woff2"]
            },
            {
              "fontFamily": "Inter",
              "fontWeight": "600",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/inter-600.woff2"]
            },
            {
              "fontFamily": "Inter",
              "fontWeight": "700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/inter-700.woff2"]
            }
          ]
        },
        {
          "slug": "mono",
          "name": "Monoespaçada",
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.875rem",
          "name": "Pequeno"
        },
        {
          "slug": "medium",
          "size": "1.0625rem",
          "name": "Médio",
          "fluid": false
        },
        {
          "slug": "large",
          "size": "1.375rem",
          "name": "Grande",
          "fluid": {
            "min": "1.25rem",
            "max": "1.5rem"
          }
        },
        {
          "slug": "x-large",
          "size": "2rem",
          "name": "Título",
          "fluid": {
            "min": "1.625rem",
            "max": "2.25rem"
          }
        },
        {
          "slug": "xx-large",
          "size": "2.75rem",
          "name": "Manchete",
          "fluid": {
            "min": "2rem",
            "max": "3.25rem"
          }
        }
      ]
    },

    "spacing": {
      "units": ["rem", "px", "%", "vw"],
      "spacingSizes": [
        { "slug": "20", "size": "0.75rem", "name": "1" },
        { "slug": "30", "size": "1.25rem", "name": "2" },
        { "slug": "40", "size": "2rem", "name": "3" },
        { "slug": "50", "size": "3rem", "name": "4" },
        { "slug": "60", "size": "4.5rem", "name": "5" }
      ]
    },

    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },

  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7",
      "fontWeight": "400"
    },
    "spacing": {
      "padding": {
        "top": "0",
        "bottom": "0",
        "left": "var(--wp--preset--spacing--30)",
        "right": "var(--wp--preset--spacing--30)"
      },
      "blockGap": "1.25rem"
    },

    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--gold-ink)"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--sunset)"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontWeight": "700",
          "lineHeight": "1.2",
          "letterSpacing": "-0.015em"
        },
        "color": {
          "text": "var(--wp--preset--color--contrast)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)",
          "lineHeight": "1.1"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontSize": "var(--wp--preset--font-size--medium)",
          "fontWeight": "700",
          "letterSpacing": "0.02em"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--gold)",
          "text": "var(--wp--preset--color--deep)"
        },
        "typography": {
          "fontWeight": "700",
          "fontSize": "var(--wp--preset--font-size--small)",
          "textDecoration": "none"
        },
        "border": {
          "radius": "0.5rem"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "bottom": "0.85rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--sunset)",
            "text": "var(--wp--preset--color--cream)"
          }
        }
      },
      "caption": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "fontStyle": "italic"
        },
        "color": {
          "text": "var(--wp--preset--color--contrast-2)"
        }
      }
    },

    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontSize": "1.25rem",
          "fontWeight": "800",
          "letterSpacing": "-0.01em"
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontWeight": "800"
        }
      },
      "core/quote": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontSize": "var(--wp--preset--font-size--large)",
          "fontStyle": "italic"
        },
        "color": {
          "text": "var(--wp--preset--color--gold-ink)"
        },
        "border": {
          "left": {
            "color": "var(--wp--preset--color--gold)",
            "style": "solid",
            "width": "3px"
          }
        },
        "spacing": {
          "padding": {
            "left": "1.5rem"
          }
        }
      },
      "core/code": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--mono)",
          "fontSize": "var(--wp--preset--font-size--small)"
        },
        "color": {
          "background": "var(--wp--preset--color--base-2)"
        },
        "border": {
          "color": "var(--wp--preset--color--rule)",
          "style": "solid",
          "width": "1px",
          "radius": "0.375rem"
        }
      },
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--rule)"
        }
      },
      "core/pullquote": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontStyle": "italic"
        }
      }
    }
  },

  "templateParts": [
    {
      "name": "header",
      "title": "Cabeçalho",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Rodapé",
      "area": "footer"
    }
  ]
}
