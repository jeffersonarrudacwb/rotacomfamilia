.claude/
.DS_Store
node_modules/
.env
.env.local
*.log
.vscode/
.idea/
__pycache__/
*.pyc

# Fotos brutas da família: ficam locais. As 8 usadas no site entram
# otimizadas em assets/img/ (exceção logo abaixo); as demais só existem
# dentro dos PDFs dos ebooks, onde já estão embutidas.
*.jpg
*.JPG
*.jpeg
*.png

# Exceção: imagens que o site realmente serve.
#
# Precisa listar cada pasta. O *.png acima é abrangente de propósito, para
# nenhuma foto bruta escapar, mas isso já engoliu em silêncio o logo de dois
# parceiros: o git add não reclama de arquivo ignorado, o build local passou,
# e o site foi ao ar apontando para imagens que não existiam no servidor.
!assets/img/**
!assets/logos/**

# Pasta montada pelo deploy (regerada a cada publicação)
dist/

# Credenciais de FTP, se algum dia forem usadas localmente. Nunca versionar.
.env
.env.deploy

# Configuração com a chave da API do Brevo. O arquivo real mora um nível acima
# da public_html, no servidor — nunca aqui. Só o modelo .exemplo.php é versionado.
rota-config.php

# Zip de deploy é regenerado
deploy-rotacomfamilia.zip

# Formatos brutos das câmeras (não vão pro repo)
*.heic
*.HEIC
*.HEIC.jpg
*.dng
*.DNG
*.mov
*.MOV
*.mp4
*.MP4

# Arquivos de lock do Word
~$*

# PDFs de terceiros usados so como referencia de leitura.
# Ficam na maquina, nunca no repositorio.
ebooks/*.pdf
!ebooks/pdf/

# Copias reduzidas das fotos, geradas pelo build dos ebooks.
ebooks/.cache-img/

# Material de terceiros usado so como referencia de leitura.
# Fica na maquina, nunca no repositorio.
complementos/

# PNG dos QR codes: material para story e video, gerado sob demanda.
# O que o site usa e o SVG embutido no HTML.
qrcodes/

# Propostas de clientes: contem nome, saldo de milhas e datas de viagem de
# terceiros. O gerador e o modelo sao versionados; os dados e os PDFs nao.
propostas/dados/*.json
!propostas/dados/MODELO*.json
propostas/pdf/
