.claude/
.DS_Store
node_modules/
.env
.env.local
*.log
.vscode/
.idea/
__pycache__/
*.pyc

# Fotos brutas da família: ficam locais. As 8 usadas no site entram
# otimizadas em assets/img/ (exceção logo abaixo); as demais só existem
# dentro dos PDFs dos ebooks, onde já estão embutidas.
*.jpg
*.JPG
*.jpeg
*.png

# Exceção: imagens que o site realmente serve.
#
# Precisa listar cada pasta. O *.png acima é abrangente de propósito, para
# nenhuma foto bruta escapar, mas isso já engoliu em silêncio o logo de dois
# parceiros: o git add não reclama de arquivo ignorado, o build local passou,
# e o site foi ao ar apontando para imagens que não existiam no servidor.
!assets/img/**
!assets/logos/**

# Exceção: os recortes do mídia kit (700 KB).
#
# São as fotos já cortadas, reduzidas a 200 DPI e sem EXIF — exatamente as
# imagens que já estão dentro do PDF que qualquer pessoa baixa do site. Ficam
# versionadas para o gatilho "Atualizar Mídia Kit" do GitHub conseguir regerar
# o documento sem ter as fotos originais, que continuam de fora.
!mediakit/recortes/**

# Pasta montada pelo deploy (regerada a cada publicação)
dist/

# Credenciais de FTP, se algum dia forem usadas localmente. Nunca versionar.
.env
.env.deploy

# Configuração com a chave da API do Brevo. O arquivo real mora um nível acima
# da public_html, no servidor — nunca aqui. Só o modelo .exemplo.php é versionado.
rota-config.php

# Zip de deploy é regenerado
deploy-rotacomfamilia.zip

# Formatos brutos das câmeras (não vão pro repo)
*.heic
*.HEIC
*.HEIC.jpg
*.dng
*.DNG
*.mov
*.MOV
*.mp4
*.MP4

# Arquivos de lock do Word
~$*

# PDFs de terceiros usados so como referencia de leitura.
# Ficam na maquina, nunca no repositorio.
ebooks/*.pdf
!ebooks/pdf/

# Copias reduzidas das fotos, geradas pelo build dos ebooks.
# Regra explicita de proposito: hoje elas ja caem no *.JPG la de cima, mas
# depender disso e como o repositorio engoliu as logos dos parceiros sem
# ninguem ver.
#
# O midia kit nao usa mais .cache-img: os recortes dele sao versionados em
# mediakit/recortes/. A linha antiga fica aqui para nao ressuscitar a pasta
# em quem ainda tiver ela na maquina.
ebooks/.cache-img/
mediakit/.cache-img/

# Material de terceiros usado so como referencia de leitura.
# Fica na maquina, nunca no repositorio.
complementos/

# PNG dos QR codes: material para story e video, gerado sob demanda.
# O que o site usa e o SVG embutido no HTML.
qrcodes/

# Propostas de clientes: contem nome, saldo de milhas e datas de viagem de
# terceiros. O gerador e o modelo sao versionados; os dados e os PDFs nao.
propostas/dados/*.json
!propostas/dados/MODELO*.json
propostas/pdf/

# Capturas de tela das contas de milhas do cliente. Sao as telas do saldo e da
# busca, com nome e programa dele.
#
# A regra era so "propostas/boni_smiles/", nomeando UMA pasta. Quando apareceu
# a propostas/reginaldo_azul/ ela ficou de fora, e teria entrado no primeiro
# git add que alguem desse com pressa. O padrao abaixo pega qualquer pasta de
# captura, do cliente que for.
propostas/*_smiles/
propostas/*_azul/
propostas/*_livelo/
propostas/*_latam/
propostas/capturas/

# Carga do banco da area de acompanhamento: leva o roteiro e as datas de viagem
# do cliente dentro. O schema.sql e versionado, este nao.
sql/seed-*.sql
